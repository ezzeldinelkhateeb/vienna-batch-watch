# ================================================================
# Vienna Batch Watch - Environment Variables Template
# ================================================================
# انسخ هذه المتغيرات وضعها في إعدادات Vercel:
# (Vercel Project > Settings > Environment Variables)
# ================================================================

# 1. Supabase Connection (قاعدة البيانات)
VITE_SUPABASE_URL="https://ayhnzvvogzetsznfqxql.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_ANON_KEY"

# 2. Supabase Service Role Key (حاسم للسيرفر والفحص التلقائي في الخلفية)
# تجده في: Supabase Dashboard > Project Settings > API > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# 3. Cron Job Secret (حماية رابط الفحص التلقائي ضد الزيارات العشوائية)
# اختر أي كلمة سر قوية من اختيارك
CRON_SECRET="vienna_cron_secret"

# 4. Telegram Bot (اختياري في Vercel لأنك تستطيع إدخالهم مباشرة من شاشة إعدادات التطبيق)
# معرف الجروب يبدأ دائماً برقم سالب مثل -1001234567890
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID="-100xxxxxxxxxx"
